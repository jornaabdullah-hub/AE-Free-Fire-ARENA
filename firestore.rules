rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() {
      return signedIn() && request.auth.token.email == "pctime310@gmail.com";
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow create: if owner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow read: if owner(uid) || admin();
      allow update: if admin();
      allow delete: if admin();
    }
    match /wallets/{uid} {
      allow read: if owner(uid) || admin();
      allow write: if false; // Only trusted Cloud Functions may change balances.
    }
    match /tournaments/{id} {
      allow read: if true;
      allow create, update, delete: if admin();
    }
    match /registrations/{id} {
      allow read: if admin() || (signedIn() && resource.data.playerUid == request.auth.uid);
      allow create, update, delete: if false; // Cloud Functions only.
    }
    match /transactions/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    match /money_requests/{id} {
      allow read: if admin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if false; // Cloud Functions only.
    }
    match /site_settings/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}